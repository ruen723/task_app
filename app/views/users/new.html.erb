<% content_for :title, "ユーザー登録" %>

<h1>ユーザー登録</h1>
<p>MVPではパスワードを再設定できません。</p>

<% if @user.errors.any? %>
  <div role="alert">
    <p>入力内容を確認してください。</p>
    <ul>
      <% @user.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @user do |form| %>
  <p>
    <%= form.label :username, "ユーザー名" %><br>
    <%= form.text_field :username, required: true, maxlength: 30, autocomplete: "username",
      aria: { describedby: "username-hint" } %><br>
    <small id="username-hint">半角英数字とアンダースコア（_）で3〜30文字。大文字と小文字は区別します。</small>
  </p>

  <p>
    <%= form.label :password, "パスワード" %><br>
    <%= form.password_field :password, value: nil, required: true, autocomplete: "new-password",
      aria: { describedby: "password-hint" } %><br>
    <small id="password-hint">15文字以上、72バイト以内で入力してください。</small>
  </p>

  <p>
    <%= form.label :password_confirmation, "パスワード（確認）" %><br>
    <%= form.password_field :password_confirmation, value: nil, required: true, autocomplete: "new-password" %>
  </p>

  <%= form.submit "登録する" %>
<% end %>
