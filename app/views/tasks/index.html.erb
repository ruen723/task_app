<% content_for :title, "タスク一覧" %>

<h1>タスク一覧</h1>
<% if flash[:alert] %>
  <p role="alert"><%= flash[:alert] %></p>
<% end %>
<p><%= link_to "タスクを登録する", new_task_path %></p>

<% if @tasks.empty? %>
  <p>タスクはまだありません。</p>
<% else %>
  <ol>
    <% @tasks.each_with_index do |task, index| %>
      <li>
        <%= task.name %>（<%= task.planned_duration %>分）
        <%= button_to "上へ", reorder_task_path(task), method: :patch,
          params: { direction: "up" }, disabled: index.zero? %>
        <%= button_to "下へ", reorder_task_path(task), method: :patch,
          params: { direction: "down" }, disabled: index == @tasks.length - 1 %>
        <%= link_to "編集", edit_task_path(task) %>
        <%= link_to "削除", task_path(task),
          data: { turbo: true, turbo_method: :delete, turbo_confirm: "このタスクを削除しますか？" } %>
      </li>
    <% end %>
  </ol>
<% end %>

<p><%= link_to "TOPに戻る", root_path %></p>
