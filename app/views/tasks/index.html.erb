<% content_for :title, "タスク一覧" %>

<h1>タスク一覧</h1>
<p><%= link_to "タスクを登録する", new_task_path %></p>

<% if @tasks.empty? %>
  <p>タスクはまだありません。</p>
<% else %>
  <ol>
    <% @tasks.each do |task| %>
      <li><%= task.name %>（<%= task.planned_duration %>分）</li>
    <% end %>
  </ol>
<% end %>

<p><%= link_to "TOPに戻る", root_path %></p>
