<% content_for :title, "タスク登録" %>

<h1>タスク登録</h1>

<% if @task.errors.any? %>
  <div role="alert">
    <p>入力内容を確認してください。</p>
    <ul>
      <% @task.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @task do |form| %>
  <p>
    <%= form.label :name %><br>
    <%= form.text_field :name, required: true, maxlength: 50 %>
  </p>

  <p>
    <%= form.label :planned_duration %>（分）<br>
    <%= form.number_field :planned_duration, required: true, min: 1, max: 1440, step: 1 %>
  </p>

  <%= form.submit "登録する" %>
<% end %>

<p><%= link_to "タスク一覧に戻る", tasks_path %></p>
