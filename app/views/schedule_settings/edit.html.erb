<% content_for :title, "時間枠設定" %>

<h1>時間枠設定</h1>

<% if flash[:alert] %>
  <p role="alert"><%= flash[:alert] %></p>
<% end %>

<% if @schedule_setting.errors.any? %>
  <div role="alert">
    <p>入力内容を確認してください。</p>
    <ul>
      <% @schedule_setting.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @schedule_setting, url: schedule_setting_path do |form| %>
  <p>
    <%= form.label :start_time %><br>
    <%= form.time_field :start_time, include_seconds: false, required: true, step: 60 %>
  </p>

  <p>
    <%= form.label :end_time %><br>
    <%= form.time_field :end_time, include_seconds: false, required: true, step: 60 %>
  </p>

  <%= form.submit "保存する" %>
<% end %>

<p><%= link_to "キャンセルしてダッシュボードへ戻る", dashboard_path %></p>
